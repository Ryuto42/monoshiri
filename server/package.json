{
  "name": "monoshiri-api",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "start": "node src/index.ts",
    "dev": "LOCAL_DEV=1 node --env-file-if-exists=.env --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "LOCAL_DEV=1 node --test --test-concurrency=1 'test/**/*.test.ts'",
    "mail:preview": "node src/mail/preview.ts",
    "notify:policy": "node src/tools/notify-policy.ts"
  },
  "type": "module",
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "@google/genai": "^3.0.0",
    "@hono/node-server": "^2.1.6",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.3",
    "hono": "^4.13.17",
    "nodemailer": "10.2.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  }
}
