rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Guests (anonymous) and Google accounts are usable right away; email/password accounts only after the address is confirmed,
    // so nobody can claim someone else's address and receive a zukan synced to it.
    function trusted() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous'
        || request.auth.token.email_verified == true;
    }

    function optString(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }

    // Curriculum unit ids (web/src/data/curriculum.json): at most 5 short strings. Rules can't loop, so each slot is checked.
    function unitIds(l) {
      return l is list && l.size() <= 5
        && (l.size() < 1 || (l[0] is string && l[0].size() <= 20))
        && (l.size() < 2 || (l[1] is string && l[1].size() <= 20))
        && (l.size() < 3 || (l[2] is string && l[2].size() <= 20))
        && (l.size() < 4 || (l[3] is string && l[3].size() <= 20))
        && (l.size() < 5 || (l[4] is string && l[4].size() <= 20));
    }

    // Topics and notes are lists of maps. Rules can't loop, so the first few entries are checked.
    function mapsAtStart(l) {
      return (l.size() < 1 || l[0] is map)
        && (l.size() < 2 || l[1] is map)
        && (l.size() < 3 || l[2] is map)
        && (l.size() < 4 || l[3] is map);
    }

    function validCard(cardId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'name', 'reading', 'en', 'category', 'icon', 'oneLiner', 'summary', 'funFact',
                               'topics', 'notes', 'illustration', 'units', 'firstFind', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['id', 'name', 'notes', 'createdAt', 'updatedAt'])
        && d.id == cardId
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && optString(d, 'reading', 80)
        && optString(d, 'en', 80)
        && optString(d, 'category', 20)
        && optString(d, 'icon', 40)
        && optString(d, 'oneLiner', 400)
        && optString(d, 'summary', 4000)
        && optString(d, 'funFact', 2000)
        && (!('topics' in d) || (d.topics is list && d.topics.size() <= 12 && mapsAtStart(d.topics)))
        && d.notes is list && d.notes.size() <= 12 && mapsAtStart(d.notes)
        && (!('firstFind' in d) || d.firstFind is bool)
        && (!('units' in d) || (d.units is list && d.units.size() <= 5 && unitIds(d.units)))
        && (!('illustration' in d) || d.illustration == null
            || (d.illustration is string && d.illustration.matches('^/media/[A-Za-z0-9/_.-]{1,200}$')
                && !d.illustration.matches('.*[.][.].*')))
        && d.createdAt is int && d.updatedAt is int
        // A far-future updatedAt would win every later sync, so it may run at most 5 minutes ahead of the server clock.
        && d.updatedAt <= request.time.toMillis() + 300000;
    }

    match /users/{uid}/cards/{cardId} {
      allow read: if isOwner(uid) && trusted();
      // Deleting needs no confirmed address, so an account that never confirmed it can still clear its cards when it is deleted.
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && trusted()
        && cardId.matches('^[0-9a-f]{24}$')
        && validCard(cardId);
    }

    // Profile: only the learning stage (never the age itself), for signed-in accounts.
    match /users/{uid} {
      allow read, delete: if isOwner(uid) && trusted();
      allow create, update: if isOwner(uid) && trusted()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['stage', 'updatedAt'])
        && request.resource.data.stage in ['lower', 'upper', 'junior', 'senior']
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt <= request.time.toMillis() + 300000;
    }

    // Caches, usage meters (meta, meter_users) and video jobs are written by the API server only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
