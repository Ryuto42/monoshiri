# Copy to web/.env.local, or generate it with: PROJECT=your-project-id node infra/write-web-env.mjs --local
# Values come from Firebase console > Project settings > Your apps (Web). They are public by design.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FB_PROJECT_ID=your-project-id
VITE_FB_APP_ID=
VITE_FB_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FB_SENDER_ID=

# API server. Local dev: http://localhost:8080
VITE_API_BASE=http://localhost:8080

# Google sign-in in the iOS / Android apps (written by infra/write-web-env.mjs once Google is enabled in Firebase Auth).
# Web client: Firebase console > Authentication > Google > Web SDK configuration. iOS client: CLIENT_ID in GoogleService-Info.plist.
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_IOS_CLIENT_ID=

# App Check (reCAPTCHA Enterprise site key; public). Created by infra/setup-appcheck.mjs and written by infra/write-web-env.mjs.
VITE_RECAPTCHA_KEY=
# Local development only: App Check debug token (infra/.appcheck-debug-token). Never set it in production builds.
VITE_APPCHECK_DEBUG_TOKEN=
