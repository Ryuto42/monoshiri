# Copy to server/.env for `npm run dev`. Only GOOGLE_CLOUD_PROJECT is required.

# Your Google Cloud / Firebase project ID (Vertex AI calls and Firebase ID token checks use it)
GOOGLE_CLOUD_PROJECT=your-project-id

# Optional: YouTube Data API key for related videos (leave empty to skip videos)
YOUTUBE_API_KEY=

# Optional: estimated AI spend (JPY) at which the server stops generating. Local dev keeps the tally in memory.
CAP_JPY=200

# Optional: origins allowed to call the API (comma separated). Setting it replaces the defaults
# (the web.app / firebaseapp.com sites, the app shells and, in local dev, http://localhost:5173).
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional: per-account caps (JPY) and how many AI videos may be made in total
# USER_CAP_GUEST_JPY=50
# USER_CAP_MEMBER_JPY=300
# VIDEO_LIMIT=2

# Optional: your own uid(s) for infra/prewarm.mjs, so prewarming is not stopped by the per-account cap
# ADMIN_UIDS=

# Optional: '1' makes new generation by guests require App Check (production only)
# APPCHECK_ENFORCE=1

# Optional: send the verification / password-reset emails yourself (Gmail + an app password). Without it Firebase's emails are used.
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=
# APP_URL=http://localhost:5173

# Optional: override models, e.g. if a model is not available in your project
# MODEL_DETECT=gemini-3.1-flash-lite
# MODEL_EXPLORE=gemini-3.8-flash
# MODEL_DEEP=gemini-3.8-flash
# MODEL_QUIZ=gemini-3.1-flash-lite
# MODEL_IMAGE=gemini-nano-banana-2.1
# MODEL_TTS=gemini-3.8-flash-lite-tts
# MODEL_VIDEO=gemini-omni-1.2-flash
